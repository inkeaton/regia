// ============================================
// Director agent for Plot: Investigation
// ============================================
// Generated by the Regia v0.2 compiler

// ============================================
// == Initial Beliefs ==
// ============================================
plot_name(investigation).
current_phase(questioning).

// ============================================
// == Boot Plan ==
// ============================================
// Runs when the Director agent is created.
// Registers plot identity and executes ON ENTER for the initial phase.
@boot__Investigation[atomic]
+!boot <-
    .my_name(Me);
    +plot_id(Me);
    .print("[Investigation] Booting up director agent ", Me, " in phase 'questioning'...");
    !on_enter(questioning).

// == Director WHEN Plans ==
@dir__Investigation__deny_crime__0
+deny_crime : current_phase(questioning) <-
    !send_to_role(officer, achieve, utter("I have my eye on you, scientist."));
    !end_plot.

@dir__Investigation__bribe_cop__0
+bribe_cop : current_phase(questioning) <-
    !send_to_role(suspect, achieve, utter("Phew. That was close."));
    !end_plot.


// ============================================
// == Phase Transition Infrastructure ==
// ============================================
@switch_phase_atomic[atomic]
+!switch_phase(Target) : current_phase(Current) <-
    .print("[Investigation] Transitioning from phase '", Current, "' to '", Target, "'...");
    !on_exit(Current);
    -current_phase(Current);
    +current_phase(Target);
    !on_enter(Target).

+!on_exit(questioning) <-
    !send_to_role(suspect, achieve, remove_playbook(suspectplaybook));
    !send_to_role(officer, achieve, remove_playbook(copplaybook));
    !send_to_role(suspect, achieve, remove_dialogue_option("opt_deny"));
    !send_to_role(officer, achieve, remove_dialogue_option("opt_bribe")).
+!on_enter(questioning) <-
    !send_to_role(suspect, achieve, add_playbook(suspectplaybook));
    !send_to_role(officer, achieve, add_playbook(copplaybook));
    !send_to_role(suspect, achieve, add_dialogue_option("opt_deny", "I didn't steal any flower! Ask the cop!", "deny_crime", "false"));
    !send_to_role(officer, achieve, add_dialogue_option("opt_bribe", "Here's 50 bucks. Look the other way.", "bribe_cop", "false")).
+!on_exit(_) <- true.
+!on_enter(_) <- true.

// ============================================
// == Plot Lifecycle Infrastructure ==
// ============================================
// If the parent terminates, it signals children with !parent_ended
+!parent_ended[source(Parent)] : parent_plot(Parent) <-
    .print("[Investigation] Parent plot ", Parent, " ended. Terminating this subplot...");
    -parent_plot(Parent);
    !end_plot.

@end_plot_atomic[atomic]
+!end_plot : current_phase(Current) <-
    .my_name(Me);
    .print("[Investigation] Ending plot. Running exit hooks and broadcasting termination...");
    !on_exit(Current);
    .findall(C, child_plot(C, _, _), Children);
    for ( .member(Child, Children) ) { .send(Child, achieve, parent_ended) };
    .findall(A, role_agent(_, A), Roles);
    for ( .member(RoleAgent, Roles) ) { .send(RoleAgent, achieve, plot_ended(Me)) };
    !notify_parent;
    .kill_agent(Me).

+!notify_parent : parent_plot(Parent) <-
    .my_name(Me);
    .send(Parent, achieve, child_ended(investigation, Me)).
+!notify_parent <- true.

@start_subplot_atomic[atomic]
+!start_subplot(SubplotStr, SubplotAtom, MappingsData) <-
    !build_bindings(MappingsData, Bindings);
    // uses current time to generate new distinct sub-plot agent id
    .time(HH, MM, SS, MS);
    .my_name(Me);
    .concat(SubplotStr, "_", Me, "_", MS, ChildId);
    .concat("director_", SubplotStr, ".asl", SourceFile);
    .print("[Investigation] Spawning subplot '", SubplotStr, "' as agent ", ChildId, " with bindings ", Bindings);
    .create_agent(ChildId, SourceFile);
    .send(ChildId, achieve, start_plot(Bindings));
    .send(ChildId, tell, parent_plot(Me));
    +child_plot(ChildId, SubplotAtom, MappingsData).

// Recursive helper to build role agent bindings from mappings
+!build_bindings([], []).
+!build_bindings([map(Target, Source) | RestMappings], [map(Target, Agents) | RestBindings]) <-
    .findall(A, role_agent(Source, A), Agents);
    !build_bindings(RestMappings, RestBindings).

// ============================================
// == Role-Agent Registry ==
// ============================================
// Populated at plot startup via !start_plot.
@dir__Investigation__start_plot__0
+!start_plot(Bindings) <-
    for ( .member(map(Role, Agents), Bindings) ) {
        for ( .member(Agent, Agents) ) {
            +role_agent(Role, Agent);
        }
    };
    !boot.

@dir__Investigation__send_to_role__0
+!send_to_role(Role, Performative, Content) <-
    .findall(A, role_agent(Role, A), Agents);
    .send(Agents, Performative, Content).

// Handle agent death (broadcast by the environment) to avoid stalling
@dir__Investigation__agent_died__0[atomic]
+agent_died(DeadAgent) : role_agent(Role, DeadAgent) <-
    .print("[Investigation] Agent ", DeadAgent, " playing role '", Role, "' has died! Cleaning registry...");
    -role_agent(Role, DeadAgent).


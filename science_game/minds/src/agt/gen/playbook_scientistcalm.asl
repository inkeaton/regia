// ============================================
// == Playbook: ScientistCalm ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(scientistcalm, _).
// Included by role templates that use this playbook.

@pb__ScientistCalm__test_utter__0
+test_utter : playbook_active(scientistcalm, _) <-
    .print("Testing utter!");
    vesna.via.utter("Behold my speech bubble!").

@pb__ScientistCalm__test_vanish__0
+test_vanish : playbook_active(scientistcalm, _) <-
    .print("Testing vanish!");
    vesna.via.utter("Poof! I'm gone! (Wait 5 seconds)");
    vesna.via.set_visible(false);
    .wait(5000);
    vesna.via.set_visible(true);
    vesna.via.utter("And I'm back!").

@pb__ScientistCalm__test_spawn__0
+test_spawn : playbook_active(scientistcalm, _) <-
    .print("Spawning a flower in the garden!");
    vesna.via.spawn_item("flower", "garden");
    vesna.via.utter("Flower conjured!").

@pb__ScientistCalm__test_despawn__0
+test_despawn : playbook_active(scientistcalm, _) <-
    .print("Despawning the flower!");
    vesna.via.despawn_item("flower");
    vesna.via.utter("Flower banished!").

@pb__ScientistCalm__tell_research__0
+tell_research : playbook_active(scientistcalm, _) <-
    !signal_directors(scientistcalm, tell_research).

@pb__ScientistCalm__back_to_main__0
+back_to_main : playbook_active(scientistcalm, _) <-
    !signal_directors(scientistcalm, back_to_main).

@pb__ScientistCalm__picked_up_flower__0
+picked_up_flower : playbook_active(scientistcalm, _) <-
    .print("The player picked up the flower!");
    vesna.via.utter("Hey! You took my flower!");
    !signal_directors(scientistcalm, flower_stolen).

@pb__ScientistCalm__apologize_event__0
+apologize_event : playbook_active(scientistcalm, _) <-
    .print("Apology received while calm!");
    vesna.via.set_dialogue_text("Wow, you got the flower! Thanks!");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_welcome", "You're welcome.", "exit", "true").


// Generated by the Regia v0.2 compiler

// ============================================
// == Included Playbooks ==
// ============================================
{ include("playbook_scientistboneplaybook.asl") }
{ include("playbook_scientistcorpseplaybook.asl") }
{ include("playbook_scientistflowerplaybook.asl") }
{ include("playbook_scientistintroplaybook.asl") }

// ============================================
// == Playbook Management ==
// ============================================
// When the Director assigns a playbook, add the
// playbook_active belief to enable its gated plans.
+!add_playbook(Name)[source(Sender)] <-
    .print("[Scientist] Added playbook ", Name, " from ", Sender);
    +playbook_active(Name, Sender).

+!remove_playbook(Name)[source(Sender)] <-
    .print("[Scientist] Removed playbook ", Name, " from ", Sender);
    -playbook_active(Name, Sender).

// Cleanup ghost playbooks when the Plot terminates
+!plot_ended(PlotId)[source(PlotId)] <-
    -playbook_active(_, PlotId).

// Signal all active directors for a given playbook
+!signal_directors(PbName, Payload) <-
    .print("[Scientist] Signaling directors of ", PbName, " with ", Payload);
    .findall(D, playbook_active(PbName, D), Directors);
    for ( .member(DirectorId, Directors) ) { .send(DirectorId, untell, Payload); .send(DirectorId, tell, Payload) }.

// ============================================
// == Director Commands ==
// ============================================
@role__forscience__scientist__believe_player_has_bone_
+!believe(player_has_bone) <- +player_has_bone.

@role__forscience__scientist__believe_player_has_corpse_
+!believe(player_has_corpse) <- +player_has_corpse.

@role__forscience__scientist__move_to__lab__
+!move_to("lab") <- vesna.via.move_to("lab").

@role__forscience__scientist__spawn_item__flower____garden__
+!spawn_item("flower", "garden") <- vesna.via.spawn_item("flower", "garden").

@role__forscience__scientist__trigger_game_over__Explosion__
+!trigger_game_over("Explosion") <- vesna.via.trigger_game_over("Explosion").

@role__forscience__scientist__trigger_game_over__Victory__
+!trigger_game_over("Victory") <- vesna.via.trigger_game_over("Victory").

@role__forscience__scientist__utter__The_potion_violently_explodes___
+!utter("The potion violently explodes!") <- vesna.via.utter("The potion violently explodes!").


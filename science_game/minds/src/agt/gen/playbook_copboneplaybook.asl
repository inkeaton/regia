// ============================================
// == Playbook: CopBonePlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(copboneplaybook, _).
// Included by role templates that use this playbook.

@pb__CopBonePlaybook__sighted_player__0
+sighted_player : playbook_active(copboneplaybook, _) & cop_very_annoyed <-
    vesna.via.utter("Don't test my patience today.").

@pb__CopBonePlaybook__sighted_player__1
+sighted_player : playbook_active(copboneplaybook, _) & cop_annoyed <-
    vesna.via.utter("Just stay out of my way.").

@pb__CopBonePlaybook__sighted_player__2
+sighted_player : playbook_active(copboneplaybook, _) & not (cop_very_annoyed) & not (cop_annoyed) <-
    vesna.via.utter("Quiet day on patrol.").

@pb__CopBonePlaybook__player_greet__0
+player_greet : playbook_active(copboneplaybook, _) <-
    vesna.via.set_dialogue_text("Move along, citizen. Nothing to see here.");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_denounce", "Now they want a bone!", "denounce_bone", "false");
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopBonePlaybook__denounce_bone__0
+denounce_bone : playbook_active(copboneplaybook, _) & cop_very_annoyed <-
    vesna.via.set_dialogue_text("Stop bothering me!");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopBonePlaybook__denounce_bone__1
+denounce_bone : playbook_active(copboneplaybook, _) & cop_annoyed <-
    vesna.via.set_dialogue_text("Stop making up stories!");
    -cop_annoyed;
    +cop_very_annoyed;
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopBonePlaybook__denounce_bone__2
+denounce_bone : playbook_active(copboneplaybook, _) & not (cop_very_annoyed) & not (cop_annoyed) <-
    vesna.via.set_dialogue_text("It's probably for a dog. Go away.");
    +cop_annoyed;
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").


// ============================================
// == Playbook: ScientistFeatures ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(scientistfeatures, _).
// Included by role templates that use this playbook.

@pb__ScientistFeatures__test_utter__0
+test_utter : playbook_active(scientistfeatures, _) <-
    .print("Testing utter!");
    vesna.via.utter("Behold my speech bubble!").

@pb__ScientistFeatures__test_vanish__0
+test_vanish : playbook_active(scientistfeatures, _) <-
    .print("Testing vanish!");
    vesna.via.utter("Poof! I'm gone! (Wait 5 seconds)");
    vesna.via.set_visible(false);
    .wait(5000);
    vesna.via.set_visible(true);
    vesna.via.utter("And I'm back!").

@pb__ScientistFeatures__test_spawn__0
+test_spawn : playbook_active(scientistfeatures, _) <-
    .print("Spawning a flower in the garden!");
    vesna.via.spawn_item("flower", "garden");
    vesna.via.utter("Flower conjured!").

@pb__ScientistFeatures__test_despawn__0
+test_despawn : playbook_active(scientistfeatures, _) <-
    .print("Despawning the flower!");
    vesna.via.despawn_item("flower");
    vesna.via.utter("Flower banished!").

@pb__ScientistFeatures__picked_up_flower__0
+picked_up_flower : playbook_active(scientistfeatures, _) <-
    .print("The player picked up the flower!");
    vesna.via.utter("Hey! You took my flower!");
    vesna.via.set_dialogue("thanks_for_flower").


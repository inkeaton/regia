// ============================================
// Director agent for Plot: ForScience
// ============================================
// Generated by the Regia v0.2 compiler

// ============================================
// == Initial Beliefs ==
// ============================================
plot_name(forscience).
current_phase(flower).

// ============================================
// == Boot Plan ==
// ============================================
// Runs when the Director agent is created.
// Registers plot identity and executes ON ENTER for the initial phase.
@boot__ForScience[atomic]
+!boot <-
    .my_name(Me);
    +plot_id(Me);
    .print("[ForScience] Booting up director agent ", Me, " in phase 'flower'...");
    !on_enter(flower).

// == Director WHEN Plans ==
@dir__ForScience__scientist_signals_scientist_asked_flower__0
+scientist_asked_flower[source(Sender)] : role_agent(scientist, Sender) <-
    !send_to_role(cop, achieve, believe(flower_requested)).

@dir__ForScience__garden_door_opened__0
+garden_door_opened : true <-
    +door_open.

@dir__ForScience__item_in_potion__0
+item_in_potion : true <-
    !send_to_role(scientist, achieve, utter("The potion violently explodes!"));
    !send_to_role(scientist, achieve, trigger_game_over("Explosion"));
    !end_plot.

@dir__ForScience__scientist_signals_start_moving_to_lab__0
+start_moving_to_lab[source(Sender)] : current_phase(flower) & role_agent(scientist, Sender) <-
    !send_to_role(scientist, achieve, move_to("lab")).

@dir__ForScience__scientist_signals_reached_lab__0
+reached_lab[source(Sender)] : current_phase(flower) & role_agent(scientist, Sender) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistintroplaybook));
    !send_to_role(scientist, achieve, add_playbook(scientistflowerplaybook)).

@dir__ForScience__give_flower__0
+give_flower : current_phase(flower) & door_open <-
    !send_to_role(cop, achieve, remove_playbook(copflowerplaybook));
    !send_to_role(dog, achieve, remove_playbook(dogmainplaybook));
    !start_subplot("missingdonut", missingdonut, [map(cop, cop), map(dog, dog)]);
    !switch_phase(bone).

@dir__ForScience__give_flower__1
+give_flower : current_phase(flower) & not (door_open) <-
    !send_to_role(cop, achieve, add_playbook(copboneplaybook));
    !send_to_role(dog, achieve, believe(has_bone));
    !switch_phase(bone).

@dir__ForScience__subplot_missingdonut_ended__0
+!subplot_ended(missingdonut) : current_phase(bone) <-
    !send_to_role(scientist, achieve, believe(player_has_bone));
    !send_to_role(cop, achieve, add_playbook(copboneplaybook));
    !send_to_role(dog, achieve, add_playbook(dogmainplaybook)).

@dir__ForScience__dog_signals_bone_acquired__0
+bone_acquired[source(Sender)] : current_phase(bone) & role_agent(dog, Sender) <-
    !send_to_role(scientist, achieve, believe(player_has_bone)).

@dir__ForScience__give_bone__0
+give_bone : current_phase(bone) <-
    !switch_phase(corpse).

@dir__ForScience__cop_signals_player_arrested__0
+player_arrested[source(Sender)] : current_phase(corpse) & role_agent(cop, Sender) <-
    !send_to_role(cop, achieve, trigger_game_over("Arrested by Cop"));
    !end_plot.

@dir__ForScience__cop_signals_cop_killed__0
+cop_killed[source(Sender)] : current_phase(corpse) & role_agent(cop, Sender) <-
    !send_to_role(scientist, achieve, believe(player_has_corpse)).

@dir__ForScience__cop_signals_scientist_arrested__0
+scientist_arrested[source(Sender)] : current_phase(corpse) & role_agent(cop, Sender) <-
    !send_to_role(cop, achieve, trigger_game_over("Scientist Arrested"));
    !end_plot.

@dir__ForScience__scientist_signals_game_won__0
+game_won[source(Sender)] : current_phase(corpse) & role_agent(scientist, Sender) <-
    !send_to_role(scientist, achieve, trigger_game_over("Victory"));
    !end_plot.


// ============================================
// == Phase Transition Infrastructure ==
// ============================================
@switch_phase_atomic[atomic]
+!switch_phase(Target) : current_phase(Current) <-
    .print("[ForScience] Transitioning from phase '", Current, "' to '", Target, "'...");
    !on_exit(Current);
    -current_phase(Current);
    +current_phase(Target);
    !on_enter(Target).

+!on_exit(flower) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistflowerplaybook));
    !send_to_role(cop, achieve, remove_playbook(copflowerplaybook)).
+!on_enter(flower) <-
    !send_to_role(scientist, achieve, add_playbook(scientistintroplaybook));
    !send_to_role(cop, achieve, add_playbook(copflowerplaybook));
    !send_to_role(dog, achieve, add_playbook(dogmainplaybook));
    !send_to_role(scientist, achieve, spawn_item("flower", "garden"));
    !send_to_role(dog, achieve, start_wandering(800)).
+!on_exit(bone) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistboneplaybook));
    !send_to_role(cop, achieve, remove_playbook(copboneplaybook));
    !send_to_role(dog, achieve, remove_playbook(dogmainplaybook)).
+!on_enter(bone) <-
    !send_to_role(scientist, achieve, add_playbook(scientistboneplaybook)).
+!on_exit(corpse) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistcorpseplaybook));
    !send_to_role(cop, achieve, remove_playbook(copcorpseplaybook));
    !send_to_role(dog, achieve, remove_playbook(dogmainplaybook)).
+!on_enter(corpse) <-
    !send_to_role(scientist, achieve, add_playbook(scientistcorpseplaybook));
    !send_to_role(cop, achieve, add_playbook(copcorpseplaybook));
    !send_to_role(dog, achieve, add_playbook(dogmainplaybook)).
+!on_exit(_) <- true.
+!on_enter(_) <- true.

// ============================================
// == Plot Lifecycle Infrastructure ==
// ============================================
// If the parent terminates, it signals children with !parent_ended
+!parent_ended[source(Parent)] : parent_plot(Parent) <-
    .print("[ForScience] Parent plot ", Parent, " ended. Terminating this subplot...");
    -parent_plot(Parent);
    !end_plot.

@end_plot_atomic[atomic]
+!end_plot : current_phase(Current) <-
    .my_name(Me);
    .print("[ForScience] Ending plot. Running exit hooks and broadcasting termination...");
    !on_exit(Current);
    .findall(C, child_plot(C, _, _), Children);
    for ( .member(Child, Children) ) { .send(Child, achieve, parent_ended) };
    .findall(A, role_agent(_, A), Roles);
    for ( .member(RoleAgent, Roles) ) { .send(RoleAgent, achieve, plot_ended(Me)) };
    !notify_parent;
    .kill_agent(Me).

+!notify_parent : parent_plot(Parent) <-
    .my_name(Me);
    .send(Parent, achieve, child_ended(forscience, Me)).
+!notify_parent <- true.

// Infrastructural cleanup when a child plot ends
@dir__infrastructure__child_ended[atomic]
+!child_ended(SubplotName, ChildId) <-
    .term2string(ChildId, ChildIdStr);
    .print("[ForScience] Subplot ", SubplotName, " (", ChildIdStr, ") ended. Cleaning up registry...");
    -child_plot(ChildIdStr, SubplotName, _);
    !!subplot_ended(SubplotName).

// Fallback to prevent Jason warnings if the user didn't write a WHEN SUBPLOT ENDS block
+!subplot_ended(_) <- true.

@start_subplot_atomic[atomic]
+!start_subplot(SubplotStr, SubplotAtom, MappingsData) <-
    !build_bindings(MappingsData, Bindings);
    // uses current time to generate new distinct sub-plot agent id
    .time(HH, MM, SS, MS);
    .my_name(Me);
    .concat(SubplotStr, "_", Me, "_", MS, ChildId);
    .concat("director_", SubplotStr, ".asl", SourceFile);
    .print("[ForScience] Spawning subplot '", SubplotStr, "' as agent ", ChildId, " with bindings ", Bindings);
    .create_agent(ChildId, SourceFile);
    .send(ChildId, achieve, start_plot(Bindings));
    .send(ChildId, tell, parent_plot(Me));
    +child_plot(ChildId, SubplotAtom, MappingsData).

// Recursive helper to build role agent bindings from mappings
+!build_bindings([], []).
+!build_bindings([map(Target, Source) | RestMappings], [map(Target, Agents) | RestBindings]) <-
    .findall(A, role_agent(Source, A), Agents);
    !build_bindings(RestMappings, RestBindings).

// ============================================
// == Role-Agent Registry ==
// ============================================
// Populated at plot startup via !start_plot.
@dir__ForScience__start_plot__0
+!start_plot(Bindings) <-
    for ( .member(map(Role, Agents), Bindings) ) {
        for ( .member(Agent, Agents) ) {
            +role_agent(Role, Agent);
        }
    };
    !boot.

@dir__ForScience__send_to_role__0
+!send_to_role(Role, Performative, Content) <-
    .findall(A, role_agent(Role, A), Agents);
    .send(Agents, Performative, Content).

// Handle agent death (broadcast by the environment) to avoid stalling
@dir__ForScience__agent_died__0[atomic]
+agent_died(DeadAgent) : role_agent(Role, DeadAgent) <-
    .print("[ForScience] Agent ", DeadAgent, " playing role '", Role, "' has died! Cleaning registry...");
    -role_agent(Role, DeadAgent).


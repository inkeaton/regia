// ============================================
// == Playbook: CopFlowerPlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(copflowerplaybook, _).
// Included by role templates that use this playbook.

@pb__CopFlowerPlaybook__sighted_player__0
+sighted_player : playbook_active(copflowerplaybook, _) & cop_very_annoyed <-
    vesna.via.utter("Keep walking, troublemaker.").

@pb__CopFlowerPlaybook__sighted_player__1
+sighted_player : playbook_active(copflowerplaybook, _) & cop_annoyed <-
    vesna.via.utter("I've got my eye on you...").

@pb__CopFlowerPlaybook__sighted_player__2
+sighted_player : playbook_active(copflowerplaybook, _) & not (cop_very_annoyed) & not (cop_annoyed) <-
    vesna.via.utter("Nothing to report.").

@pb__CopFlowerPlaybook__player_greet__0
+player_greet : playbook_active(copflowerplaybook, _) <-
    vesna.via.set_dialogue_text("Move along, citizen. Nothing to see here.");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_denounce", "The scientist is asking for a flower...", "denounce_flower", "false");
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopFlowerPlaybook__denounce_flower__0
+denounce_flower : playbook_active(copflowerplaybook, _) & cop_annoyed <-
    vesna.via.set_dialogue_text("I told you, it's just a flower.");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopFlowerPlaybook__denounce_flower__1
+denounce_flower : playbook_active(copflowerplaybook, _) & not (cop_annoyed) <-
    vesna.via.set_dialogue_text("It's only a flower, stop wasting my time.");
    +cop_annoyed;
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").


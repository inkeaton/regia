// ============================================
// == Playbook: DogMainPlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(dogmainplaybook, _).
// Included by role templates that use this playbook.

@pb__DogMainPlaybook__player_greet__0
+player_greet : playbook_active(dogmainplaybook, _) & has_bone <-
    vesna.via.set_dialogue_text("*Woof*");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_ask_bone", "Give me the bone.", "ask_dog_bone", "false");
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__DogMainPlaybook__player_greet__1
+player_greet : playbook_active(dogmainplaybook, _) & not (has_bone) <-
    vesna.via.set_dialogue_text("*Woof*");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__DogMainPlaybook__ask_dog_bone__0
+ask_dog_bone : playbook_active(dogmainplaybook, _) & has_bone <-
    vesna.via.utter("*Woof!* (Drops bone)");
    -has_bone;
    vesna.via.remove_dialogue_option("opt_ask_bone");
    vesna.via.add_item("bone");
    !signal_directors(dogmainplaybook, bone_acquired).

@pb__DogMainPlaybook__ask_dog_bone__1
+ask_dog_bone : playbook_active(dogmainplaybook, _) & not (has_bone) <-
    vesna.via.utter("*Whines confusedly* (I don't have it!)").


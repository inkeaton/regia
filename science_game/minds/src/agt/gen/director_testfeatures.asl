// ============================================
// Director agent for Plot: TestFeatures
// ============================================
// Generated by the Regia v0.2 compiler

// ============================================
// == Initial Beliefs ==
// ============================================
plot_name(testfeatures).
current_phase(calm).

// ============================================
// == Boot Plan ==
// ============================================
// Runs when the Director agent is created.
// Registers plot identity and executes ON ENTER for the initial phase.
@boot__TestFeatures[atomic]
+!boot <-
    .my_name(Me);
    +plot_id(Me);
    .print("[TestFeatures] Booting up director agent ", Me, " in phase 'calm'...");
    !on_enter(calm).

// == Director WHEN Plans ==
@dir__TestFeatures__flower_stolen__0
+flower_stolen : current_phase(calm) <-
    !switch_phase(angry).

@dir__TestFeatures__calmed_down__0
+calmed_down : current_phase(angry) <-
    !switch_phase(calm).

@dir__TestFeatures__subplot_investigation_ended__0
+!child_ended(investigation, _) : current_phase(angry) <-
    !send_to_role(scientist, achieve, utter("The subplot has officially concluded!")).


// ============================================
// == Phase Transition Infrastructure ==
// ============================================
@switch_phase_atomic[atomic]
+!switch_phase(Target) : current_phase(Current) <-
    .print("[TestFeatures] Transitioning from phase '", Current, "' to '", Target, "'...");
    !on_exit(Current);
    -current_phase(Current);
    +current_phase(Target);
    !on_enter(Target).

+!on_exit(calm) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistcalm)).
+!on_enter(calm) <-
    !send_to_role(scientist, achieve, add_playbook(scientistcalm));
    !send_to_role(scientist, achieve, set_dialogue_text("Behold my new Regia capabilities! What shall I do?"));
    !send_to_role(scientist, achieve, clear_dialogue_options);
    !send_to_role(scientist, achieve, add_dialogue_option("opt_research", "Tell me about your research.", "tell_research", "false"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_utter", "Speak to me!", "test_utter", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_vanish", "Perform a vanishing act.", "test_vanish", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_spawn", "Conjure a flower.", "test_spawn", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_despawn", "Banish the flower.", "test_despawn", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_leave", "That is all. (Leave)", "exit", "true")).
+!on_exit(angry) <-
    !send_to_role(scientist, achieve, remove_playbook(scientistangry)).
+!on_enter(angry) <-
    !send_to_role(scientist, achieve, add_playbook(scientistangry));
    !send_to_role(scientist, achieve, set_dialogue_text("I am furious! Someone stole my flower! What do you want?!"));
    !send_to_role(scientist, achieve, clear_dialogue_options);
    !send_to_role(scientist, achieve, add_dialogue_option("opt_utter", "Speak to me!", "test_utter", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_vanish", "Perform a vanishing act.", "test_vanish", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_spawn", "Conjure a flower.", "test_spawn", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_despawn", "Banish the flower.", "test_despawn", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_leave", "That is all. (Leave)", "exit", "true"));
    !send_to_role(scientist, achieve, add_dialogue_option("opt_apologize", "I am sorry for taking it.", "apologize_event", "false"));
    !start_subplot("investigation", investigation, [map(suspect, scientist), map(officer, cop)]).
+!on_exit(_) <- true.
+!on_enter(_) <- true.

// ============================================
// == Plot Lifecycle Infrastructure ==
// ============================================
// If the parent terminates, it signals children with !parent_ended
+!parent_ended[source(Parent)] : parent_plot(Parent) <-
    .print("[TestFeatures] Parent plot ", Parent, " ended. Terminating this subplot...");
    -parent_plot(Parent);
    !end_plot.

@end_plot_atomic[atomic]
+!end_plot : current_phase(Current) <-
    .my_name(Me);
    .print("[TestFeatures] Ending plot. Running exit hooks and broadcasting termination...");
    !on_exit(Current);
    .findall(C, child_plot(C, _, _), Children);
    for ( .member(Child, Children) ) { .send(Child, achieve, parent_ended) };
    .findall(A, role_agent(_, A), Roles);
    for ( .member(RoleAgent, Roles) ) { .send(RoleAgent, achieve, plot_ended(Me)) };
    !notify_parent;
    .kill_agent(Me).

+!notify_parent : parent_plot(Parent) <-
    .my_name(Me);
    .send(Parent, achieve, child_ended(testfeatures, Me)).
+!notify_parent <- true.

@start_subplot_atomic[atomic]
+!start_subplot(SubplotStr, SubplotAtom, MappingsData) <-
    !build_bindings(MappingsData, Bindings);
    // uses current time to generate new distinct sub-plot agent id
    .time(HH, MM, SS, MS);
    .my_name(Me);
    .concat(SubplotStr, "_", Me, "_", MS, ChildId);
    .concat("director_", SubplotStr, ".asl", SourceFile);
    .print("[TestFeatures] Spawning subplot '", SubplotStr, "' as agent ", ChildId, " with bindings ", Bindings);
    .create_agent(ChildId, SourceFile);
    .send(ChildId, achieve, start_plot(Bindings));
    .send(ChildId, tell, parent_plot(Me));
    +child_plot(ChildId, SubplotAtom, MappingsData).

// Recursive helper to build role agent bindings from mappings
+!build_bindings([], []).
+!build_bindings([map(Target, Source) | RestMappings], [map(Target, Agents) | RestBindings]) <-
    .findall(A, role_agent(Source, A), Agents);
    !build_bindings(RestMappings, RestBindings).

// ============================================
// == Role-Agent Registry ==
// ============================================
// Populated at plot startup via !start_plot.
@dir__TestFeatures__start_plot__0
+!start_plot(Bindings) <-
    for ( .member(map(Role, Agents), Bindings) ) {
        for ( .member(Agent, Agents) ) {
            +role_agent(Role, Agent);
        }
    };
    !boot.

@dir__TestFeatures__send_to_role__0
+!send_to_role(Role, Performative, Content) <-
    .findall(A, role_agent(Role, A), Agents);
    .send(Agents, Performative, Content).

// Handle agent death (broadcast by the environment) to avoid stalling
@dir__TestFeatures__agent_died__0[atomic]
+agent_died(DeadAgent) : role_agent(Role, DeadAgent) <-
    .print("[TestFeatures] Agent ", DeadAgent, " playing role '", Role, "' has died! Cleaning registry...");
    -role_agent(Role, DeadAgent).


@pb__ScientistAngry__test_utter__0
+test_utter : playbook_active(scientistangry, _) <-
    vesna.via.utter("Don't talk to me! I'm mad about my flower!").

@pb__ScientistAngry__test_spawn__0
+test_spawn : playbook_active(scientistangry, _) <-
    vesna.via.utter("No more flowers for you!").

@pb__ScientistAngry__test_vanish__0
+test_vanish : playbook_active(scientistangry, _) <-
    vesna.via.utter("Fine! I'm taking a deep breath...");
    !signal_directors(scientistangry, calmed_down).

@pb__ScientistAngry__picked_up_flower__0
+picked_up_flower : playbook_active(scientistangry, _) <-
    vesna.via.utter("I don't have any more flowers!").

@pb__ScientistAngry__apologize_event__0
+apologize_event : playbook_active(scientistangry, _) <-
    .print("Apology received while angry!");
    vesna.via.update_dialogue("apology_rejected").


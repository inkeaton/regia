// ============================================
// == Role: Cop in Plot: MissingDonut ==
// ============================================
// Generated by the Regia v0.2 compiler

// ============================================
// == Included Playbooks ==
// ============================================
{ include("playbook_copsubplotplaybook.asl") }

// ============================================
// == Playbook Management ==
// ============================================
// When the Director assigns a playbook, add the
// playbook_active belief to enable its gated plans.
+!add_playbook(Name)[source(Sender)] <-
    .print("[Cop] Added playbook ", Name, " from ", Sender);
    +playbook_active(Name, Sender).

+!remove_playbook(Name)[source(Sender)] <-
    .print("[Cop] Removed playbook ", Name, " from ", Sender);
    -playbook_active(Name, Sender).

// Cleanup ghost playbooks when the Plot terminates
+!plot_ended(PlotId)[source(PlotId)] <-
    -playbook_active(_, PlotId).

// Signal all active directors for a given playbook
+!signal_directors(PbName, Payload) <-
    .print("[Cop] Signaling directors of ", PbName, " with ", Payload);
    .findall(D, playbook_active(PbName, D), Directors);
    for ( .member(DirectorId, Directors) ) { .send(DirectorId, untell, Payload); .send(DirectorId, tell, Payload) }.

// ============================================
// == Director Commands ==
// ============================================
@role__missingdonut__cop__believe_has_bone_
+!believe(has_bone) <- +has_bone.

@role__missingdonut__cop__believe_has_donut_
+!believe(has_donut) <- +has_donut.

@role__missingdonut__cop__utter__The_bone_has_been_secured___
+!utter("The bone has been secured.") <- vesna.via.utter("The bone has been secured.").


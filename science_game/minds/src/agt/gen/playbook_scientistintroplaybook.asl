// ============================================
// == Playbook: ScientistIntroPlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(scientistintroplaybook, _).
// Included by role templates that use this playbook.

@pb__ScientistIntroPlaybook__picked_up_flower__0
+picked_up_flower : playbook_active(scientistintroplaybook, _) <-
    +player_has_flower.

@pb__ScientistIntroPlaybook__sighted_player__0
+sighted_player : playbook_active(scientistintroplaybook, _) & moving_to_lab <-
    vesna.via.utter("Follow me to the lab!").

@pb__ScientistIntroPlaybook__sighted_player__1
+sighted_player : playbook_active(scientistintroplaybook, _) & not (moving_to_lab) <-
    vesna.via.utter("I have a proposal for you...").

@pb__ScientistIntroPlaybook__player_greet__0
+player_greet : playbook_active(scientistintroplaybook, _) & moving_to_lab <-
    vesna.via.set_dialogue_text("Wait until we are in the lab to speak!");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__ScientistIntroPlaybook__player_greet__1
+player_greet : playbook_active(scientistintroplaybook, _) & not (moving_to_lab) <-
    vesna.via.set_dialogue_text("I have a proposal for you, but we must discuss it in my lab.");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "I'll follow you.", "accept_intro", "true").

@pb__ScientistIntroPlaybook__accept_intro__0
+accept_intro : playbook_active(scientistintroplaybook, _) <-
    +moving_to_lab;
    !signal_directors(scientistintroplaybook, start_moving_to_lab).

@pb__ScientistIntroPlaybook__reached_lab__0
+reached_lab : playbook_active(scientistintroplaybook, _) <-
    vesna.via.utter("Ah, finally some peace and quiet.");
    !signal_directors(scientistintroplaybook, reached_lab).


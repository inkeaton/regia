// ============================================
// == Playbook: DogSubplotPlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(dogsubplotplaybook, _).
// Included by role templates that use this playbook.

@pb__DogSubplotPlaybook__player_greet__0
+player_greet : playbook_active(dogsubplotplaybook, _) & has_donut <-
    vesna.via.set_dialogue_text("*Woof!* (Chews donut loudly)");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_donut", "Drop the donut!", "ask_dog_donut", "false");
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__DogSubplotPlaybook__player_greet__1
+player_greet : playbook_active(dogsubplotplaybook, _) & not (has_donut) <-
    vesna.via.set_dialogue_text("*Woof!*");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__DogSubplotPlaybook__ask_dog_donut__0
+ask_dog_donut : playbook_active(dogsubplotplaybook, _) & has_donut <-
    vesna.via.utter("*Happy barks* (Drops donut)");
    -has_donut;
    vesna.via.remove_dialogue_option("opt_donut");
    vesna.via.add_item("donut");
    !signal_directors(dogsubplotplaybook, player_got_donut).

@pb__DogSubplotPlaybook__ask_dog_donut__1
+ask_dog_donut : playbook_active(dogsubplotplaybook, _) & not (has_donut) <-
    vesna.via.utter("*Whines* (I don't have it)").


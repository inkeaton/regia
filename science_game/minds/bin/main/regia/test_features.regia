# Base Vocabulary
ACTION vesna.via.set_visible(visible) AS set_visible.
ACTION vesna.via.utter(text) AS utter.

# We declare the Jason internal actions we need to bridge with the environment
ACTION vesna.via.spawn_item(item, waypoint) AS spawn_item.
ACTION vesna.via.despawn_item(item) AS despawn_item.

ACTION vesna.via.set_dialogue_text(text) AS set_dialogue_text.
ACTION vesna.via.add_dialogue_option(id, text, event, close_ui) AS add_dialogue_option.
ACTION vesna.via.clear_dialogue_options AS clear_dialogue_options.
ACTION vesna.via.remove_dialogue_option(id) AS remove_dialogue_option.

EVENT test_utter.
EVENT test_vanish.
EVENT test_spawn.
EVENT test_despawn.
EVENT picked_up_flower.
EVENT apologize_event.

EVENT flower_stolen.
EVENT calmed_down.
EVENT deny_crime.
EVENT bribe_cop.
EVENT tell_research.
EVENT back_to_main.

# The Playbook that will be assigned to the scientist when calm
PLAYBOOK ScientistCalm:

    WHEN test_utter:
        DO PRINT("Testing utter!").
        DO utter("Behold my speech bubble!").
        
    WHEN test_vanish:
        DO PRINT("Testing vanish!").
        DO utter("Poof! I'm gone! (Wait 5 seconds)").
        DO set_visible(false).
        DO WAIT(5000).
        DO set_visible(true).
        DO utter("And I'm back!").

    WHEN test_spawn:
        DO PRINT("Spawning a flower in the garden!").
        DO spawn_item("flower", "garden").
        DO utter("Flower conjured!").

    WHEN test_despawn:
        DO PRINT("Despawning the flower!").
        DO despawn_item("flower").
        DO utter("Flower banished!").

    WHEN tell_research:
        DO set_dialogue_text("Ah, Regia! It empowers me to structure my mind using logical rules, separated clearly from Godot's visual engine. It is a paradigm shift!").
        DO clear_dialogue_options.
        DO add_dialogue_option("opt_back", "Fascinating. Let's talk about something else.", "back_to_main", "false").
        DO add_dialogue_option("opt_leave", "I must go. (Leave)", "exit", "true").

    WHEN back_to_main:
        DO set_dialogue_text("What else would you like to discuss?").
        DO clear_dialogue_options.
        DO add_dialogue_option("opt_research", "Tell me about your research again.", "tell_research", "false").
        DO add_dialogue_option("opt_utter", "Speak to me!", "test_utter", "true").
        DO add_dialogue_option("opt_vanish", "Perform a vanishing act.", "test_vanish", "true").
        DO add_dialogue_option("opt_spawn", "Conjure a flower.", "test_spawn", "true").
        DO add_dialogue_option("opt_despawn", "Banish the flower.", "test_despawn", "true").
        DO add_dialogue_option("opt_leave", "That is all. (Leave)", "exit", "true").

    WHEN picked_up_flower:
        DO PRINT("The player picked up the flower!").
        DO utter("Hey! You took my flower!").
        SIGNAL flower_stolen.

    WHEN apologize_event:
        DO PRINT("Apology received while calm!").
        DO set_dialogue_text("Wow, you got the flower! Thanks!").
        DO clear_dialogue_options.
        DO add_dialogue_option("opt_welcome", "You're welcome.", "exit", "true").

# The Playbook that will be assigned to the scientist when angry
PLAYBOOK ScientistAngry:

    WHEN test_utter:
        DO utter("Don't talk to me! I'm mad about my flower!").

    WHEN test_spawn:
        DO utter("No more flowers for you!").

    WHEN test_vanish:
        DO utter("Fine! I'm taking a deep breath...").
        SIGNAL calmed_down.
        
    WHEN picked_up_flower:
        DO utter("I don't have any more flowers!").

    WHEN apologize_event:
        DO PRINT("Apology received while angry!").
        DO set_dialogue_text("I accept your apology... but I'm still mad.").
        DO clear_dialogue_options.
        DO add_dialogue_option("opt_leave", "Understood. (Leave)", "exit", "true").

PLAYBOOK SuspectPlaybook:
    WHEN deny_crime:
        DO utter("I am innocent! Ask the cop!").
        SIGNAL deny_crime.

PLAYBOOK CopPlaybook:
    WHEN bribe_cop:
        DO utter("Hmm. Very well. I didn't see anything.").
        SIGNAL bribe_cop.

PLOT Investigation.
    PHASE questioning INITIAL.

    ROLE Suspect.
    ROLE Officer.

    DURING questioning:
        ON ENTER:
            ASSIGN SuspectPlaybook TO Suspect.
            ASSIGN CopPlaybook TO Officer.
            Suspect DO add_dialogue_option("opt_deny", "I didn't steal any flower! Ask the cop!", "deny_crime", "false").
            Officer DO add_dialogue_option("opt_bribe", "Here's 50 bucks. Look the other way.", "bribe_cop", "false").
        
        ON EXIT:
            UNASSIGN SuspectPlaybook FROM Suspect.
            UNASSIGN CopPlaybook FROM Officer.
            Suspect DO remove_dialogue_option("opt_deny").
            Officer DO remove_dialogue_option("opt_bribe").
       
        WHEN deny_crime:
            Officer DO utter("I have my eye on you, scientist.").
            END PLOT.
        
        WHEN bribe_cop:
            Suspect DO utter("Phew. That was close.").
            END PLOT.

# The Plot managed by the Director agent
PLOT TestFeatures.
    PHASE calm INITIAL.
    PHASE angry.

    ROLE Scientist.
    ROLE Cop.

    DURING calm:
        ON ENTER:
            ASSIGN ScientistCalm TO Scientist.
            Scientist DO set_dialogue_text("Behold my new Regia capabilities! What shall I do?").
            Scientist DO clear_dialogue_options.
            Scientist DO add_dialogue_option("opt_research", "Tell me about your research.", "tell_research", "false").
            Scientist DO add_dialogue_option("opt_utter", "Speak to me!", "test_utter", "true").
            Scientist DO add_dialogue_option("opt_vanish", "Perform a vanishing act.", "test_vanish", "true").
            Scientist DO add_dialogue_option("opt_spawn", "Conjure a flower.", "test_spawn", "true").
            Scientist DO add_dialogue_option("opt_despawn", "Banish the flower.", "test_despawn", "true").
            Scientist DO add_dialogue_option("opt_leave", "That is all. (Leave)", "exit", "true").
        ON EXIT:
            UNASSIGN ScientistCalm FROM Scientist.

        WHEN flower_stolen:
            TRANSITION TO angry.

    DURING angry:
        ON ENTER:
            ASSIGN ScientistAngry TO Scientist.
            Scientist DO set_dialogue_text("I am furious! Someone stole my flower! What do you want?!").
            Scientist DO clear_dialogue_options.
            Scientist DO add_dialogue_option("opt_utter", "Speak to me!", "test_utter", "true").
            Scientist DO add_dialogue_option("opt_vanish", "Perform a vanishing act.", "test_vanish", "true").
            Scientist DO add_dialogue_option("opt_spawn", "Conjure a flower.", "test_spawn", "true").
            Scientist DO add_dialogue_option("opt_despawn", "Banish the flower.", "test_despawn", "true").
            Scientist DO add_dialogue_option("opt_leave", "That is all. (Leave)", "exit", "true").
            Scientist DO add_dialogue_option("opt_apologize", "I am sorry for taking it.", "apologize_event", "false").
            START SUBPLOT Investigation MAPPING Scientist TO Suspect, Cop TO Officer.
       
        ON EXIT:
            UNASSIGN ScientistAngry FROM Scientist.
            # We don't need to manually remove apologize or reset text here because 
            # transitioning to 'calm' will trigger calm's ON ENTER which clears and sets the baseline.
        
        WHEN calmed_down:
            TRANSITION TO calm.
        
        WHEN SUBPLOT Investigation ENDS:
            Scientist DO utter("The subplot has officially concluded!").



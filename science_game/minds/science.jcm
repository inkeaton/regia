mas science_game {

    // Roles for the game
    agent scientist:scientist.asl {
        ag-class:   vesna.VesnaAgent
        address:    "172.26.80.1"
        port:       9001
    }

    agent coordinator:ready_agent.asl {
        ag-class:   vesna.VesnaAgent
        address:    "172.26.80.1"
        port:       9200
    }

    agent testfeatures_director:gen/director_testfeatures.asl {
        beliefs: role_agent(scientist, scientist)
        goals: boot
    }

}

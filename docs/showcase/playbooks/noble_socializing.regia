IMPORT "../vocabulary".

#@desc: How Guests pass the time with each other: small talk, insults, gossip.
PLAYBOOK NobleSocializing:
    ROLE peer.

    # Small talk. The more grudges we hold against those at the table, the likelier we vent one.
    WHEN idle:
        ?grudges = COUNT(grudge(?foe, ?) AND ?foe PLAYS peer).
        EITHER, WEIGHT 3: DO chat.
        OR, WEIGHT 2:
            DO sip_wine.
            IF RANDOM(1, 100) <= 30:         # one cup too many
                DO laugh.
        OR, WEIGHT ?grudges: PURSUE vent.
        OR, WEIGHT 5: PASS                   # nothing, this time

    # We insult someone we resent who is at the table: the bigger the grudge, the likelier.
    TO vent:
        GIVEN grudge(?foe, ?size) AND ?foe PLAYS peer, WEIGHT ?size:
            DO sneer_at(?foe).
            TELL ?foe insulted.
            TELL EVERYONE scandal(?foe).

    # Three ways to take an insult. The Selection function picks the one that suits us.
    WHEN insulted FROM peer ?who, SUITS aggressiveness AT 0.8 AND bravery AT 0.8:
        DO stand_up.
        SIGNAL insult_thrown(?who).

    #@desc: Scowl, and remember it. Only at someone we already resent.
    WHEN insulted FROM peer ?who, SUITS sympathy AT -0.5, SHIFTS aggressiveness BY 0.3:
        GIVEN grudge(?who, ?):
            DO scowl_at(?who).
            PURSUE resent(?who).

    # `?_who` names who we ignore, so that the three ways read alike.
    WHEN insulted FROM peer ?_who, SUITS sympathy AT 0.7, SHIFTS aggressiveness BY -0.1:
        DO laugh.

    TO resent(?who):
        IF grudge(?who, ?size):              # fills ?size, for this branch only
            CHANGE grudge(?who, ?size) TO grudge(?who, ?size + 1).
        ELSE:
            LEARN grudge(?who, 1).

    # Gossip about me: the speaker is spreading my humiliation.
    WHEN scandal(ME) FROM peer ?speaker:
        SHIFT sympathy BY -0.2.
        TELL 50 PERCENT OF peer wronged(ME, ?speaker).
        PURSUE resent(?speaker).

    # Gossip about someone else.
    WHEN scandal(?victim) FROM peer ?speaker:
        GIVEN grudge(?victim, ?):
            DO snigger.
        GIVEN grudge(?speaker, ?), SHIFTS sympathy BY -0.1:
            DO roll_eyes.
        # no ELSE: gossip about strangers falls through to the next Playbook

    # A peer tells us who wronged them. We side with them if we resent the offender too.
    WHEN wronged(?victim, ?offender) LEARNED FROM peer:
        GIVEN grudge(?offender, ?):
            DO bow_to(?victim).

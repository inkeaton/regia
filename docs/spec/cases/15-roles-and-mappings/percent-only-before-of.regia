#! case: % writes the share of a count, only before OF; it is never a Value or a remainder
#! rule: R1517

CUE bored
ACTION wave, yawn

PLAYBOOK Host:
    WHEN bored:
        LET ?half BE 50%.          #! error R1517
        RANDOMLY:
            OPTION, WEIGHT 30%:    #! error R1517
                DO wave.
            OPTION:
                DO yawn.

#! case: a name declared in a file this one doesn't reach is not declared
#! rule: R10_04-name-out-of-scope

GAME CUE insult_heard(speaker)
ACTION punch(target)

PLAYBOOK Brawler:
    WHEN insult_heard(?s):
        GIVEN hungry:                    #! error R10_04-name-out-of-scope
            DO punch(?s).

#! case: LET on a Placeholder the Context already filled is an error, not a reassignment
#! rule: R04_05-let-on-filled-placeholder

FACT health(points)
GAME CUE hit

PLAYBOOK Fighter:
    WHEN hit:
        GIVEN health(?h):
            LET ?h BE ?h - 1.            #! error R04_05-let-on-filled-placeholder
            PRINT("health", ?h).

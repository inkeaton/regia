#! case: EITHER and OR headers are the retired spelling of a Random choice
#! rule: R09_06-retired-either

GAME CUE bored
ACTION wave, yawn

PLAYBOOK Idler:
    WHEN bored:
        EITHER: DO wave.                 #! error R09_06-retired-either
        OR: DO yawn.                     #! error R09_06-retired-either

#! case: UPDATE names the same Fact on both sides
#! rule: R08_04-update-to-another-fact

FACT health(points), score(points)
GAME CUE hit(damage)

PLAYBOOK Fighter:
    WHEN hit(?d):
        GIVEN health(?h):
            UPDATE health(?h) TO score(?h - ?d).     #! error R08_04-update-to-another-fact

#! case: two Playbooks ordered over each other form a cycle
#! rule: R13_01-precedence-cycle

GAME CUE insult_heard
ACTION punch, sing

PLAYBOOK Brawling:
    WHEN insult_heard: DO punch.

PLAYBOOK Drunkard:
    WHEN insult_heard: DO sing.

PLOT Tavern:
    ROLE Patron:
        ASSIGN Brawling.
        ASSIGN Drunkard.
    PHASE open INITIAL.

    PRECEDENCE:
        Brawling OVER Drunkard.
        Drunkard OVER Brawling.          #! error R13_01-precedence-cycle

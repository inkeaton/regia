#! case: TELL sends Facts and Cues; a Goal is asked for with ASK … TO
#! rule: R07_01-tell-with-goal

GAME CUE insult_heard(speaker)
GOAL avenge(person)
ACTION challenge(target)

PLAYBOOK Guest:
    WHEN insult_heard(?s), FROM ?who:
        TELL ?who avenge(?s).            #! error R07_01-tell-with-goal

    TO avenge(?p):
        DO challenge(?p).

#! case: END PLOT ends its Body
#! rule: R17_02-statement-after-end-plot

GAME CUE guards_arrived
ACTION stop_music

PLOT Banquet:
    PHASE reception INITIAL.

    DURING PLOT:
        WHEN guards_arrived:
            END PLOT.
            DO stop_music.               #! error R17_02-statement-after-end-plot

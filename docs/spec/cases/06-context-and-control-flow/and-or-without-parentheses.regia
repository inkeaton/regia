#! case: AND and OR mixed at one level need parentheses
#! rule: R06_01-and-or-without-parentheses

FACT is_hungry, is_drunk, hates(person)
GAME CUE food_served
ACTION eat_food

PLAYBOOK Guest:
    WHEN food_served:
        GIVEN is_hungry OR is_drunk AND hates(?):     #! error R06_01-and-or-without-parentheses
            DO eat_food.

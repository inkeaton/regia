            DO act_3.
        ELSE:
            DO act_1.
    WHEN evt_2:
        IF fct_2:
            DO act_4.
            DO act_5.
        ELSE:
            DO act_2.
    WHEN evt_3:
        IF fct_3:
            DO act_6.
            DO act_7.
        ELSE:
            DO act_3.
    WHEN evt_4:
        IF fct_4:
            DO act_8.
            DO act_9.
        ELSE:
            DO act_4.
    WHEN evt_5:
        IF fct_0:
            DO act_0.
            DO act_1.
        ELSE:
            DO act_5.
    WHEN evt_6:
        IF fct_1:
            DO act_2.
            DO act_3.
        ELSE:
            DO act_6.
    WHEN evt_7:
        IF fct_2:
            DO act_4.
            DO act_5.
        ELSE:
            DO act_7.
    WHEN evt_8:
        IF fct_3:
            DO act_6.
            DO act_7.
        ELSE:
            DO act_8.
    WHEN evt_9:
        IF fct_4:
            DO act_8.
            DO act_9.
        ELSE:
            DO act_9.

# =======================================================
# Main Plot
# =======================================================

PLOT MainPlot.

    PHASE phase_0 INITIAL.
    PHASE phase_1.

    ROLE Role0.
    ROLE Role1.

    DURING PLOT:
        WHEN evt_0:
            END PLOT.

    DURING phase_0:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.

        WHEN evt_1:
            TRANSITION TO phase_1.

    DURING phase_1:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.

        WHEN evt_2:
            END PLOT.

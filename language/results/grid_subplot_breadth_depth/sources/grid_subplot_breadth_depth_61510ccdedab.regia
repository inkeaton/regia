EVENT evt_9.

# == Facts ==
FACT fct_0.
FACT fct_1.
FACT fct_2.
FACT fct_3.
FACT fct_4.

# =======================================================
# Playbooks
# =======================================================

PLAYBOOK Playbook0:
    WHEN evt_0:
        IF fct_0:
            DO act_0.
            DO act_1.
        ELSE:
            DO act_0.
    WHEN evt_1:
        IF fct_1:
            DO act_2.
            DO act_3.
        ELSE:

EVENT evt_983.
EVENT evt_984.
EVENT evt_985.
EVENT evt_986.
EVENT evt_987.
EVENT evt_988.
EVENT evt_989.
EVENT evt_990.
EVENT evt_991.
EVENT evt_992.
EVENT evt_993.
EVENT evt_994.
EVENT evt_995.
EVENT evt_996.
EVENT evt_997.
EVENT evt_998.
EVENT evt_999.

# == Facts ==
FACT fct_0.
FACT fct_1.
FACT fct_2.
FACT fct_3.
FACT fct_4.

# =======================================================
# Playbooks
# =======================================================

PLAYBOOK Playbook0:
    WHEN evt_0:
        IF fct_0:
            DO act_0.
            DO act_1.
        ELSE:
            DO act_0.
    WHEN evt_1:
        IF fct_1:
            DO act_2.
            DO act_3.
        ELSE:
            DO act_1.

PLAYBOOK Playbook1:
    WHEN evt_2:
        IF fct_2:
            DO act_4.
            DO act_5.
        ELSE:
            DO act_2.
    WHEN evt_3:
        IF fct_3:
            DO act_6.
            DO act_7.
        ELSE:
            DO act_3.

# =======================================================
# Main Plot
# =======================================================

PLOT MainPlot.

    PHASE phase_0 INITIAL.
    PHASE phase_1.

    ROLE Role0.
    ROLE Role1.

    DURING PLOT:
        WHEN evt_0:
            END PLOT.

    DURING phase_0:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.

        WHEN evt_1:
            TRANSITION TO phase_1.

    DURING phase_1:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.

        WHEN evt_2:
            END PLOT.

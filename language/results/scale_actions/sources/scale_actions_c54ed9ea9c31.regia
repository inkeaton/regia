# Playbooks
# =======================================================

PLAYBOOK Playbook0:
    WHEN evt_0:
        IF fct_0:
            DO act_0.
            DO act_1.
        ELSE:
            DO act_0.
    WHEN evt_1:
        IF fct_1:
            DO act_2.
            DO act_3.
        ELSE:
            DO act_1.

PLAYBOOK Playbook1:
    WHEN evt_2:
        IF fct_2:
            DO act_4.
            DO act_5.

# =======================================================
# Main Plot
# =======================================================

PLOT MainPlot.

    PHASE phase_0 INITIAL.
    PHASE phase_1.
    PHASE phase_2.

    ROLE Role0.
    ROLE Role1.
    ROLE Role2.
    ROLE Role3.
    ROLE Role4.

    DURING PLOT:
        WHEN evt_0:
            END PLOT.

    DURING phase_0:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.
            ASSIGN Playbook2 TO Role2.
            WORLD DO act_2.
            ASSIGN Playbook3 TO Role3.
            WORLD DO act_3.
            ASSIGN Playbook4 TO Role4.
            WORLD DO act_4.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.
            UNASSIGN Playbook2 FROM Role2.
            UNASSIGN Playbook3 FROM Role3.
            UNASSIGN Playbook4 FROM Role4.

        WHEN evt_1:
            TRANSITION TO phase_1.

    DURING phase_1:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.
            ASSIGN Playbook2 TO Role2.
            WORLD DO act_2.
            ASSIGN Playbook3 TO Role3.
            WORLD DO act_3.
            ASSIGN Playbook4 TO Role4.
            WORLD DO act_4.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.
            UNASSIGN Playbook2 FROM Role2.
            UNASSIGN Playbook3 FROM Role3.
            UNASSIGN Playbook4 FROM Role4.

        WHEN evt_2:
            TRANSITION TO phase_2.

    DURING phase_2:
        ON ENTER:
            ASSIGN Playbook0 TO Role0.
            WORLD DO act_0.
            ASSIGN Playbook1 TO Role1.
            WORLD DO act_1.
            ASSIGN Playbook2 TO Role2.
            WORLD DO act_2.
            ASSIGN Playbook3 TO Role3.
            WORLD DO act_3.
            ASSIGN Playbook4 TO Role4.
            WORLD DO act_4.

        ON EXIT:
            UNASSIGN Playbook0 FROM Role0.
            UNASSIGN Playbook1 FROM Role1.
            UNASSIGN Playbook2 FROM Role2.
            UNASSIGN Playbook3 FROM Role3.
            UNASSIGN Playbook4 FROM Role4.

        WHEN evt_3:
            END PLOT.

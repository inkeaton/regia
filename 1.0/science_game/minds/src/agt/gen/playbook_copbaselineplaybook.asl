// ============================================
// == Playbook: CopBaselinePlaybook ==
// ============================================
// Generated by the Regia v0.2 compiler
// Plans are gated by playbook_active(copbaselineplaybook, _).
// Included by role templates that use this playbook.

@pb__CopBaselinePlaybook__player_greet__0
+player_greet : playbook_active(copbaselineplaybook, _) <-
    vesna.via.set_dialogue_text("Move along, citizen. Nothing to see here.");
    vesna.via.clear_dialogue_options;
    vesna.via.add_dialogue_option("opt_exit", "Goodbye.", "exit_dialogue", "true").

@pb__CopBaselinePlaybook__denounce_cop__0
+denounce_cop : playbook_active(copbaselineplaybook, _) & cop_very_annoyed <-
    vesna.via.utter("That is it! You are under arrest for harassment!");
    !signal_directors(copbaselineplaybook, player_arrested).

@pb__CopBaselinePlaybook__denounce_cop__1
+denounce_cop : playbook_active(copbaselineplaybook, _) & not (cop_very_annoyed) <-
    vesna.via.utter("Stop making up stories. Leave the scientist alone.");
    +cop_very_annoyed.


mas science_game {

    // Roles for the game
    agent scientist:scientist.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9001
    }

    agent cop:cop.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9002
    }

    agent dog:dog.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9003
    }

    agent forscience_director:gen/director_forscience.asl {
        ag-class:   vesna.VesnaAgent
        address:    localhost
        port:       9004
        goals: start_plot([map(scientist, [scientist]), map(cop, [cop]), map(dog, [dog])])
    }
}

# Vocabulary Declarations

# Actions used by Playbooks
ACTION toast(target).
ACTION eat_food.
ACTION complain.
ACTION greet(target).
ACTION talk(target).
ACTION insult(target1, target2).
ACTION cheer(target1, target2).
ACTION watch(target1, target2).

# Actions used by the Director (WORLD DO and Role DO)
ACTION call_guards.
ACTION lock_doors.
ACTION play_music.
ACTION serve_wine.
ACTION stop_music.

# Events triggering Playbook and Plot WHEN blocks
EVENT food_served.
EVENT insult_heard.
EVENT digestion_check.
EVENT assassin_spotted.
EVENT insult_thrown.
EVENT ask_for_food.
EVENT duel_resolved.
EVENT refuse_food.
EVENT good_food_found.
EVENT ball_declared.

EVENT princess_speaks.
EVENT pretender_speaks.

# Facts used in Playbook IF conditions
FACT is_hungry.
FACT is_drunk.
FACT hates(person).
FACT likes_food.

# Playbooks
#@desc: Reactive behaviour for guests mingling and eating at banquet.
PLAYBOOK NobleSocializing:
    WHEN insult_heard PRIORITY 5 TEMPER sympathy(-0.5) EFFECTS aggressiveness(0.2):
    IF NOT is_drunk AND hates(host):
        DO complain.
        SIGNAL insult_thrown.
    ELSE:
        DO toast(host).

    WHEN digestion_check:
        IF is_hungry:
            DO eat_food.
            DO FORGET(is_hungry).
            DO PRINT("A guest finishes their meal.").

    WHEN food_served:
        DO PRINT("A guest notices food arriving.").

        % is this "host"? or "Host"? Maybe it's a typo from the docs.
        % I will write the capital version in the rest of the code
        IF (is_hungry OR is_drunk) AND NOT hates(host):
            DO eat_food.
        ELSE:
            DO complain.

    # NobleEnamoured and NobleFriend have a similar behaviour when dancing
    # (that is, in the case of the specific global plot we are considering,
    # during the ball phase).
    When start_dancing:
        DO watch(Princess, Pretender).

PLAYBOOK PrincessSocializing:
    # I don't feel like this is the proper way of encoding the 5th requirement...
    # I'll use the events "princess_speaks" and "pretender_speaks" but it is
    # probably an oversimplification
    # WHEN play_music:
    #    DO greet(Guest).

    # good_food_found can be triggered by the SeekFood subplot
    WHEN food_served OR good_food_found:
    IF likes_food:
        DO eat_food.
    ELSE:
        SIGNAL refuse_food.

# yeah I am using SomethingSocializing for everything.
PLAYBOOK PretenderSocializing:
    # see the ball phase in the main plot
    WHEN start_dancing PRIORITY 9:
        DO FORGET(talk(Guest)).
        DO talk(Princess).

    WHEN food_served PRIORITY 1:
        DO talk(Guest).

PLAYBOOK NobleEnamoured:
    When start_dancing:
        DO insult(Princess, Pretender).

PLAYBOOK NobleFriend:
    When start_dancing:
        DO cheer(Princess, Pretender).

# Plots

#@desc: A subplot for finding food when the Princess dislikes the current one.
PLOT SeekFood.
    ROLE Explorer.
    # ... some logic here ...
    WORLD DO PRINT("The food is finally found.")
    WORLD DO good_food_found. # signal handled by the PrincessSocializing's playbook
    END PLOT.

#@desc: A subplot describing a duel.
PLOT HonorDuel.
    PHASE combat INITIAL.

    ROLE Challenger.

    DURING combat:
        WHEN duel_resolved:
        WORLD DO PRINT("The duel is over.").
        END PLOT.

#@desc: The main narrative flow of the Royal Banquet.
PLOT RoyalBanquet.

    PHASE reception INITIAL.
    PHASE feast.
    PHASE ball.
    PHASE duel_interruption.

    ROLE Host.
    ROLE Guest.

    Role Princess.
    Role Pretender.

    DURING PLOT:
        WHEN assassin_spotted PRIORITY 9:
            WORLD DO lock_doors.
            Host DO call_guards.
            END PLOT.

        WHEN princess_speaks PRIORITY 8:
            UNASSIGN NobleSocializing FROM Guest. 
            ASSIGN NobleEnamoured TO Guest.

        WHEN princess_speaks PRIORITY 7:
            UNASSIGN NobleSocializing FROM Guest. 
            ASSIGN NobleFriend TO Guest.

    DURING reception:
        ON ENT
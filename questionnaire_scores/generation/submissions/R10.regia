ACTION toast(target).
ACTION eat_food.
ACTION complain.
ACTION speak(target).


ACTION call_guards.
ACTION lock_doors.
ACTION play_music.
ACTION serve_wine.
ACTION stop_music.


EVENT food_served.
EVENT insult_heard.
EVENT digestion_check.
EVENT assassin_spotted.
EVENT insult_thrown.
EVENT duel_resolved.
EVENT princess_talk.
EVENT dancers_near.
EVENT near_guest.
EVENT ready_to_dance.
EVENT princess_greeted.
EVENT pretender_greeted.
EVENT found_food.


FACT is_hungry.
FACT is_drunk.
FACT hates(person).
FACT enamoured.
FACT friendly.
FACT likes(foodstuff).

PLAYBOOK NobleSocializing:

    WHEN insult_heard PRIORITY 5 TEMPER sympathy(-0.5)
        EFFECTS aggressiveness(0.2):
        IF NOT is_drunk AND hates(host):
            DO complain.
            SIGNAL insult_thrown.
        ELSE:
            DO toast(host).

    WHEN digestion_check:
        IF is_hungry:
            DO eat_food.
            DO FORGET(is_hungry).
            DO PRINT("A guest finishes their meal.").

    WHEN food_served:
        DO PRINT("A guest notices food arriving.").
        IF (is_hungry OR is_drunk) AND NOT hates(host):
            DO eat_food.
        ELSE:
            DO complain.
    
    WHEN princess_greeted:
        DO BELIEVE(enamoured).

    WHEN pretender_greeted:
        DO BELIEVE(friendly).    

PLAYBOOK NobleBall:
    WHEN dancers_near :
        IF friendly AND NOT enamoured:
            DO cheer.
        IF enamoured AND NOT friendly:
            SIGNAL insult_thrown.
        ELSE:
            DO watch.


PLAYBOOK PrincessReception:
    WHEN near_guest:
        IF not_spoken(guest):
            DO speak(guest).

PLAYBOOK PrincessFeast:
    WHEN food_served:
        IF likes(food):
            DO eat_food.
        ELSE:
            SIGNAL food_request.

    WHEN dance_check:
        IF ready_to_dance:
            SIGNAL begin_ball.
        
PLAYBOOK PretenderFeast:
    
    WHEN near_guest:
        IF not_spoken(guest):
            DO speak(guest).

PLAYBOOK PretenderBall:

    WHEN princess_talk:
        DO speak(princess).

PLOT HonorDuel.

    PHASE combat INITIAL.

    ROLE Challenger.

    DURING combat:
        WHEN duel_resolved:
            WORLD DO PRINT("The duel is over.").
            END PLOT.

PLOT FoodSearch.
    
    PHASE search INITIAL.
    
    ROLE Pretender.

    DURING search:
        WHEN found_food:
            END PLOT.

PLOT RoyalBanquet.

    PHASE reception INITIAL.
    PHASE feast.
    PHASE duel_interruption.
    PHASE ball.

    ROLE Host.
    ROLE Guest.
    ROLE Princess.
    ROLE Pretender.

    DURING PLOT:
        WHEN assassin_spotted PRIORITY 9:
            WORLD DO lock_doors.
            Host DO call_guards.
            END PLOT.

    DURING reception:
        ON ENTER:
            WORLD DO play_music.
            ASSIGN NobleSocializing TO Guest.
            ASSIGN NobleSocializing TO Pretender.
            ASSIGN PrincessReception TO Princess.

    WHEN food_served:
        TRANSITION TO feast.

    DURING feast:
        ON ENTER:
            WORLD DO serve_wine.
            ASSIGN PretenderFeast TO Pretender.
            UNASSIGN PrincessReception FROM Princess.
            ASSIGN PrincessFeast TO Princess.

        WHEN ROLE Princess SIGNALS begin_ball:
            TRANSITION TO ball.

        WHEN ROLE Princess SIGNALS food_request:
            START SUBPLOT FoodSearch MAPPING Pretender TO Pretender.

        WHEN ROLE Guest SIGNALS insult_thrown:
            WORLD DO stop_music.
            START SUBPLOT HonorDuel MAPPING Guest TO Challenger.
            TRANSITION TO duel_interruption.

        ON EXIT:
            UNASSIGN NobleSocializing FROM Guest.
            UNASSIGN PrincessFeast FROM Princess.

    DURING duel_interruption:
        WHEN SUBPLOT HonorDuel ENDS:
        WORLD DO PRINT("The duel is settled. The banquet is ruined.").

    DURING ball.
        ON ENTER:
            UNASSIGN NobleSocializing FROM Pretender.
            UNASSIGN PretenderFeast FROM Pretender.
           
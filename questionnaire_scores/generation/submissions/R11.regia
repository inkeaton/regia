PLOT RoyalBanquet.
  ROLE Princess
  ROLE Pretender

EVENT food_offered

PLOT RoyalBanquette.
  DURING reception:
    ASSIGN PrincessReception to Princess
    ASSIGN NobleSocializing TO Pretender.
  DURING feast:
    ASSIGN PrincessFeast to Princess
    ASSIGN Talk TO Pretender.

PLAYBOOK PrincessReception:
  greet(guest)

PLAYBOOK Talk:
  talk
  WHEN food_asked:
     search_food
     SIGNAL food_offered TO Princess
  WHEN ball_asked:
      start_dance
  
PLAYBOOK PrincessFeast:
  ask_food(pretender)
  WHEN food_offered:
    IF like_it:
      eat
    ELSE:
      refuse
  ask_ball(pretender)
  start_dance

  


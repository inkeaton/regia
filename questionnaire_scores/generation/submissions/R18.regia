# Vocabulary Declarations

# Actions used by Playbooks
ACTION toast(target).
ACTION eat_food.
ACTION complain.

# ### ADDED
ACTION greet(target).
ACTION talk(target).
ACTION check_for_food.
ACTION give_to_princess(food).

# Actions used by the Director (WORLD DO and Role DO)
ACTION call_guards.
ACTION lock_doors.
ACTION play_music.
ACTION serve_wine.
ACTION stop_music.

# Events triggering Playbook and Plot WHEN blocks
EVENT food_served.
EVENT insult_heard.
EVENT digestion_check.
EVENT assassin_spotted.
EVENT insult_thrown.
EVENT duel_resolved.

# Facts used in Playbook IF conditions
FACT is_hungry.
FACT is_drunk.
FACT hates(person).

# ### ADDED
FACT likes(food).

# Playbooks

#@desc: Reactive behaviour for guests mingling and eating at the banquet.
PLAYBOOK NobleSocializing:

WHEN insult_heard PRIORITY 5 TEMPER sympathy(-0.5) EFFECTS aggressiveness(0.2):
IF NOT is_drunk AND hates(host):
DO complain.
SIGNAL insult_thrown.
ELSE:
DO toast(host).

WHEN digestion_check:
IF is_hungry:
DO eat_food.
DO FORGET(is_hungry).
DO PRINT("A guest finishes their meal.").

WHEN food_served:
DO PRINT("A guest notices food arriving.").
IF (is_hungry OR is_drunk) AND NOT hates(host):
DO eat_food.
ELSE:
DO complain.

# ### ADDED
#@desc: Reactive behaviour for the Princess
PLAYBOOK PrincessSocializing:

WHEN food_served:
IF likes(food):
DO eat_food.

# ### ADDED
#@desc: Reactive behaviour for the Pretender
PLAYBOOK PretenderSocializing:

WHEN digestion_check:
DO talk(Guest).

# Plots

# ### ADDED
#@desc: A subplot describing the search for food.
PLOT SearchFood.

PHASE quest INITIAL.

Role Pretender.
ROLE Princess.

DURING quest:
DO check_for_food.
IF likes(food):
DO give_to_princess(food).

END PLOT.

#@desc: A subplot describing a duel.
PLOT HonorDuel.

PHASE combat INITIAL.

ROLE Challenger.

DURING combat:
WHEN duel_resolved:
WORLD DO PRINT("The duel is over.").
END PLOT.

#@desc: The main narrative flow of the Royal Banquet.
PLOT RoyalBanquet.

PHASE reception INITIAL.
PHASE feast.
PHASE duel_interruption.

ROLE Host.
ROLE Guest.

# ### ADDED
ROLE Princess.
ROLE Pretender.

DURING PLOT:
WHEN assassin_spotted PRIORITY 9:
WORLD DO lock_doors.
Host DO call_guards.
END PLOT.

DURING reception:
ON ENTER:
WORLD DO play_music.
ASSIGN NobleSocializing TO Guest.

# ### ADDED
ASSIGN PrincessSocializing TO Princess.
ASSIGN NobleSocializing TO Pretender.
Princess DO greet(Guest).

WHEN food_served:
TRANSITION TO feast.

DURING feast:
ON ENTER:
WORLD DO serve_wine.


# ### ADDED
UNASSIGN NobleSocializing FROM Pretender.
ASSIGN PretenderSocializing TO Pretender.

WHEN ROLE Guest SIGNALS insult_thrown:
WORLD DO stop_music.
START SUBPLOT HonorDuel MAPPING Guest TO Challenger.
TRANSITION TO duel_interruption.

ON EXIT:
UNASSIGN NobleSocializing FROM Guest.

DURING duel_interruption:
WHEN SUBPLOT HonorDuel ENDS:
WORLD DO PRINT("The duel is settled. The banquet is ruined.").
END PLOT.